# Copy to .env and fill in. .env is gitignored — it never leaves your machine.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Then run any script with:
#   set -a && source .env && set +a && node scripts/import.mjs

# Project Settings -> Data API -> Project URL
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Project Settings -> API Keys -> the PUBLISHABLE key (sb_publishable_...).
# Not the secret key: this one is safe in a browser, and RLS is what actually
# protects the data.
SUPABASE_KEY="sb_publishable_..."

# The Supabase user you created under Authentication -> Users. The scripts
# sign in as you because Row Level Security refuses anonymous writes.
IMC_EMAIL="you@example.com"
IMC_PASSWORD=""
